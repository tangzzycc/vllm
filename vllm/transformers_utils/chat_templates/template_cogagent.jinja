{%- for message in messages -%}
{%- if message['role'] == 'user' -%}
{{- ' [INST] ' -}}
{%- if message['content'] is string -%}
{{- message['content'] -}}
{%- else -%}
{%- for item in message['content'] -%}
{%- if item['type'] == 'text' -%}
{{- item['text'] -}}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{- ' [/INST] ' -}}
{%- elif message['role'] == 'assistant' -%}
{%- if message['content'] is string -%}
{{- message['content'] -}}
{%- else -%}
{%- for item in message['content'] -%}
{%- if item['type'] == 'text' -%}
{{- item['text'] -}}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- else -%}
{{- raise_exception('CogAgent supports only user and assistant roles') -}}
{%- endif -%}
{%- endfor -%}
